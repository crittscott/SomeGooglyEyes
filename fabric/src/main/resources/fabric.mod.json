{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "environment": "*",
  "accessWidener": "somegoogly.accesswidener",
  "mixins": [
    "somegoogly.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.github.crittscott.somegoogly.fabric.SomeGooglyFabric"
    ],
    "client": [
      "com.github.crittscott.somegoogly.client.fabric.SomeGooglyFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=17",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "geckolib": "*"
  }
}
